# ── LLM Keys ──────────────────────────────────────────────────────────────────
# Get a FREE Groq key at https://console.groq.com  (primary, recommended)
GROQ_API_KEY=your_groq_api_key_here

# Optional Gemini fallback – https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Image generation – free key at https://enter.pollinations.ai (flux model is free)
POLLINATIONS_API_KEY=your_pollinations_api_key_here
POLLINATIONS_MODEL=flux

# ── Model Selection ────────────────────────────────────────────────────────────
# Groq model to use (fast & free)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Output Settings ────────────────────────────────────────────────────────────
OUTPUT_DIR=output

# ── Image Dimensions (pixels) ─────────────────────────────────────────────────
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1080
# Fetch size from API (smaller = less pollen; upscaled to IMAGE_* locally)
FETCH_WIDTH=768
FETCH_HEIGHT=768

# ── SSL (Windows / corporate proxy) ───────────────────────────────────────────
# Set to false only if you get CERTIFICATE_VERIFY_FAILED errors
SSL_VERIFY=true
