{
  "name": "prompt2post-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "docker compose exec -T postgres psql -U prompt2post -d prompt2post -f /docker-entrypoint-initdb.d/01-init.sql"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "groq-sdk": "^0.25.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.7",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "sonner": "^1.7.1",
    "stripe": "^17.0.0",
    "svix": "^1.95.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
