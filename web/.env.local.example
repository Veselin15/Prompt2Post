# ──────────────────────────────────────────────
# Prompt2Post Web – Environment Variables
# Copy to .env.local and fill in all values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────

# ── Clerk Authentication ──────────────────────
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional for local dev (user sync happens on dashboard login)
CLERK_WEBHOOK_SECRET=

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── PostgreSQL (Docker) ───────────────────────
# Start DB: npm run db:up
DATABASE_URL=postgresql://prompt2post:prompt2post@localhost:5432/prompt2post

# ── AI – Groq ─────────────────────────────────
# Free tier: https://console.groq.com
GROQ_API_KEY=gsk_...
# Optional: override the planner/structure model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional: upgrade ONLY the quality-critical writer + creative-brief calls for
# richer copy. Auto-falls back to the default if the model is unavailable.
# GROQ_WRITER_MODEL=moonshotai/kimi-k2-instruct

# ── AI – Image Generation ─────────────────────
# Pollinations.ai (free / no key required for basic use)
POLLINATIONS_API_KEY=
# Optional: image model (default: flux); set enhance=false to send our exact prompt.
# POLLINATIONS_MODEL=flux
# POLLINATIONS_ENHANCE=true

# ── Stripe (optional for local dev) ───────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=

# ── Instagram / Meta (Pro + Creator feature) ──
# Create a Meta App at: https://developers.facebook.com
# Products to add: Facebook Login, Instagram Graph API
# Permissions needed: instagram_basic, instagram_content_publish,
#                     pages_show_list, pages_read_engagement
# Set OAuth Redirect URI to: {NEXT_PUBLIC_URL}/api/instagram/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── App ───────────────────────────────────────
# Used as base URL for OAuth redirect URIs — must be HTTPS in production
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Scheduled publishing (optional) ───────────
# Protects /api/instagram/schedule/run for cron callers (Vercel Cron sends
# "Authorization: Bearer $CRON_SECRET" automatically). Leave empty locally —
# due posts also publish whenever the owner opens their dashboard.
CRON_SECRET=
